{
  "description": "Flags architecture modules as drift when a git commit lands.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/commit_watch.py"],
            "timeout": 20
          }
        ]
      }
    ]
  }
}
